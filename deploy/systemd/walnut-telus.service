[Unit]
Description=TELUS worker: read-only check and recordings download into the private store
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=walnut-pipeline
Group=walnut-pipeline
SupplementaryGroups=walnut-telus
UMask=0007
WorkingDirectory=/opt/walnut-desk
ExecStart=/opt/walnut-desk/pipeline/.venv/bin/python -m pipeline telus-worker
TimeoutStartSec=3h
Nice=10
# hardening: may write only the private store and the bridge folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/walnut-private /var/lib/walnut-desk-telus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
